<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        The MCP stdio transport uses stdout exclusively for JSON-RPC messages - any stray log
        line there corrupts the protocol stream for a real client (Claude Code/Desktop). Every
        appender here targets stderr instead, in both server mode and index-CLI mode.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
